@page "/"

<PageTitle>Alidade</PageTitle>

@* Map canvas, fills the full viewport *@
<MapViewport />

@* Invisible data-push components *@
<DrawPreviewLayer />

@* Toolbar across the top *@
<Toolbar />

@* Floating panels, in order from back to front *@
@foreach (OsmElementRef pinned in mapState.State.PinnedInspectors)
{
    @* Pinned inspectors, one per locked element, independently draggable *@
    <InspectorPanel PinnedRef="pinned" />
}
<InspectorPanel />
<MultiSelectInspectorPanel />
<ValidationPanel />
<BackgroundPanel />
<SettingsPanel />
<GridifyPanel />

@* Dialogs, in order from back to front *@
<ConflictResolutionDialog />
<ChangesetUploadDialog />
<SwitchEndpointDialog />
<SwitchAccountDialog />
<SelectAccountDialog />
<RecoverDraftDialog />
