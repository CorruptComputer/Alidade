
@if (authState.State.PendingAccountSwitch is StoredAccount pending)
{
    <Dialog TDialog="SwitchAccountDialog" CanClose="false">
        <ChildContent>
            <p>
                You have unsaved changes. Before switching to
                <strong>@pending.Username</strong>
                you must either upload or discard them.
            </p>
        </ChildContent>
        <Actions>
            @if (ActiveEndpointState == EndpointState.Enabled)
            {
                <button class="btn btn-primary" @onclick="Upload">Upload Changes</button>
            }
            else
            {
                <button class="btn btn-primary" disabled>Upload Changes</button>
            }
            <button class="btn btn-danger" @onclick="() => Discard(pending)">Discard Changes</button>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </Actions>
    </Dialog>
}
