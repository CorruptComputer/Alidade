<div class="gridify-panel @(_visible ? "" : "gridify-panel--hidden")" @ref="_panelEl">
    <div class="gridify-header" @ref="_headerEl">
        <span>Gridify</span>
        <button class="panel-close" @onclick="Cancel">X</button>
    </div>

    @if (_wayId is null)
    {
        <div class="gridify-no-selection">
            Select a single closed way to gridify.
        </div>
        <div class="gridify-actions">
            <button class="btn-secondary" @onclick="Cancel">Close</button>
        </div>
    }
    else
    {
        <div class="gridify-form">
            <label>
                Rows
                <input type="number" min="1" max="99" value="@_rows" @oninput="OnRowsInput" />
            </label>
            <label>
                Columns
                <input type="number" min="1" max="99" value="@_cols" @oninput="OnColsInput" />
            </label>
            <label>
                Rotation (°)
                <input type="number" min="0" max="360" step="1" value="@_rotation" @oninput="OnRotationInput" />
            </label>
        </div>
        <div class="gridify-actions">
            <button class="btn-secondary" @onclick="Cancel">Cancel</button>
            <button class="btn-primary" @onclick="ApplyAsync">Apply</button>
        </div>
    }
</div>
