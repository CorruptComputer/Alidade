
@if (authState.State.IsAccountSwitcherOpen)
{
    <Dialog TDialog="SelectAccountDialog" OnClose="Close" Class="account-dialog">
        <ChildContent>
            <div class="account-list">
                @foreach (StoredAccount account in authState.State.StoredAccounts)
                {
                    bool isActive = authState.State.User?.UserId == account.UserId;
                    <button class="account-row @(isActive ? "account-row-active" : null)"
                            @onclick="() => Select(account)"
                            disabled="@isActive">
                        @if (account.AvatarUrl is not null)
                        {
                            <img class="account-avatar" src="@account.AvatarUrl" alt="" />
                        }
                        else
                        {
                            <div class="account-avatar account-avatar-placeholder">
                                @account.Username[0]
                            </div>
                        }
                        <span class="account-name">@account.Username</span>
                        @if (isActive)
                        {
                            <span class="account-active-badge">Active</span>
                        }
                    </button>
                }
            </div>
        </ChildContent>
        <Actions>
            <button class="btn btn-secondary" @onclick="Login">+ Login</button>
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        </Actions>
    </Dialog>
}
