@using Alidade.Services

<div class="preset-panel">
    <div class="preset-search-row">
        <input @key="_inputKey"
               @ref="_searchInput"
               type="text"
               placeholder="Search presets…"
               @oninput="OnQueryChanged"
               class="preset-search-input" />
    </div>

    @if (_results.Count > 0)
    {
        <ul class="preset-results">
            @foreach (Preset preset in _results)
            {
                Preset p = preset;
                <li @onclick="() => ApplyPreset(p)" class="preset-result">
                    @if (p.Icon is not null)
                    {
                        <span class="preset-icon" title="@p.Icon">●</span>
                    }
                    <span class="preset-name">@PresetService.FormatTagLabel(p)</span>
                </li>
            }
        </ul>
    }

    @if (_activePreset is not null && SelectionState.State.HasSelection)
    {
        <div class="preset-fields">
            <div class="preset-active-name">@PresetService.FormatTagLabel(_activePreset)</div>
            @foreach (FieldDef field in PresetService.ResolveFields(_activePreset))
            {
                <PresetField Field="field" ElementRef="SelectionState.State.SingleSelected!" />
            }
        </div>
    }
</div>
